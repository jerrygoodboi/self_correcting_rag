# LLM Provider Configuration ("gemini" or "ollama")
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=gemini

# Google Gemini API Configuration (Used for embeddings / fallback LLM)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Local Ollama / Tailscale Configuration (Used for LLM reasoning)
OLLAMA_BASE_URL=http://100.86.245.68:11434
OLLAMA_MODEL=qwen2.5-coder:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
MAX_RETRIES=3

# Vector Store (ChromaDB)
CHROMA_PERSIST_DIR=./data/chromadb
CHROMA_COLLECTION_NAME=knowledge_base

# PostgreSQL LangGraph Checkpointer
# Connect to PostgreSQL (e.g. docker container ops-postgres on port 5433)
POSTGRES_URI=postgresql://postgres:postgres@localhost:5433/self_correcting_rag
USE_POSTGRES_CHECKPOINTER=true

# Server
HOST=0.0.0.0
PORT=8000
